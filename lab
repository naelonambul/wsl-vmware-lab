#!/usr/bin/env bash
# The lab's single entry point (WSL). One lab command at a time per checkout.
#
#   ./lab account [--lock]         vmrest API account + secrets file (once; --lock: permissions only)
#   ./lab setup [--recreate]       WSL tools, Ubuntu image, cloud-init seed, base VM (once)
#   ./lab status [--start-vmrest | --plan]   checks; --plan: preview preserving live power
#   ./lab up [--all | <vm>...] [--allow-destroy]  create/bootstrap off; start selection only
#   ./lab down (--all | <vm>...) [--hard]  graceful shutdown; explicit hard stop
#   ./lab configure [PLAYBOOK] [ansible-playbook options]
#   ./lab destroy [-auto-approve]  delete every VM of this checkout
#   ./lab cleanup                  retry cleanup left by an interrupted delete
#   ./lab network                  read-only Windows/VMX network evidence (no vmrest)
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
cmd="${1:-}"
[[ $# -gt 0 ]] && shift

usage() { sed -n '2,12p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }

# Two lab commands on the same checkout (two terminals, an agent and a person)
# would race on the Terraform state, the base and the inventory.
lock() {
  exec 9>"$here/.lab.lock"
  if ! flock -n 9; then
    echo "[ERROR] Another lab command is running in $here; wait for it to finish." >&2
    exit 1
  fi
}

# Keep fd 9 open through the session leader and every child. A wrapper must
# not close it: a surviving Terraform/bootstrap child must retain the lock.
run_locked() {
  lock
  local child rc signal_sent=0
  # Bash background jobs otherwise inherit SIGINT ignored. Reset it before
  # starting the session (GNU coreutils env, available on the supported WSL).
  # --wait preserves the command's status even if setsid must fork because
  # its caller is already a process-group leader.
  env --default-signal=INT,TERM setsid --wait bash "$@" <&0 &
  child=$!
  forward() {
    if [[ "$signal_sent" == 0 ]]; then
      case "$1" in INT) signal_sent=130 ;; TERM) signal_sent=143 ;; esac
      kill -s "$1" -- "-$child" 2>/dev/null || true
    fi
  }
  trap 'forward INT' INT
  trap 'forward TERM' TERM
  while :; do
    rc=0; wait "$child" || rc=$?
    # wait can return for the trap while the child still runs; keep waiting.
    kill -0 "$child" 2>/dev/null || break
  done
  trap - INT TERM
  if [[ "$signal_sent" != 0 ]]; then
    echo '[WARN] Run interrupted; check ./lab status before continuing.' >&2
    return "$signal_sent"
  fi
  return "$rc"
}

case "$cmd" in
  network)
    [[ $# -eq 0 ]] || usage
    exec bash "$here/lib/network.sh" ;;
  setup)
    lock
    [[ $# -eq 0 || "$*" == --recreate ]] || usage
    missing=()
    for tool in terraform ansible-playbook qemu-img cloud-localds gpgv; do
      command -v "$tool" >/dev/null || missing+=("$tool")
    done
    [[ -f /usr/share/keyrings/ubuntu-cloudimage-keyring.gpg ]] || missing+=(ubuntu-cloudimage-keyring)
    if [[ ${#missing[@]} -gt 0 ]]; then
      echo "[INFO] Installing WSL tools (missing: ${missing[*]}); sudo asks for your WSL password"
      sudo bash "$here/lib/wsl-tools.sh"
    fi
    exec bash "$here/lib/base.sh" "$@" ;;
  account)
    [[ $# -eq 0 || "$*" == --lock ]] || usage
    exec bash "$here/lib/account.sh" "$@" ;;
  status)
    case "${1:-}" in
      --plan) shift; exec bash "$here/lib/diagnose.sh" "$@" ;;   # read-only Terraform plan
      --start-vmrest|'') ;;
      *) usage ;;
    esac
    rc=0
    bash "$here/lib/preflight.sh" "$@" || rc=$?
    echo '== VMs'
    bash "$here/lib/lifecycle.sh" status || rc=$?
    exit "$rc" ;;
  up)        run_locked "$here/lib/lifecycle.sh" on "$@" ;;
  down)      run_locked "$here/lib/lifecycle.sh" off "$@" ;;
  destroy)   run_locked "$here/lib/lifecycle.sh" destroy "$@" ;;
  cleanup)   run_locked "$here/lib/lifecycle.sh" cleanup "$@" ;;
  configure) run_locked "$here/lib/configure.sh" "$@" ;;
  *) usage ;;
esac

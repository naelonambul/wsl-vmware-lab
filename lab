#!/usr/bin/env bash
# The lab's single entry point (WSL). One lab command at a time per checkout.
#
#   ./lab account [--lock]         vmrest API account + secrets file (once; --lock: permissions only)
#   ./lab setup [--recreate]       WSL tools, Ubuntu image, cloud-init seed, base VM (once)
#   ./lab status [--start-vmrest]   host and VM checks
#   ./lab up [--all | <vm>...] [--allow-destroy] [--dry-run]  create/bootstrap off; start selection only
#   ./lab down (--all | <vm>...) [--hard] [--dry-run]  graceful shutdown; explicit hard stop
#   ./lab configure [PLAYBOOK] [ansible-playbook options]
#   ./lab destroy --confirm=<names> [--dry-run]  delete the exact state VM set
#   ./lab cleanup                  retry cleanup left by an interrupted delete
#   ./lab network                  read-only Windows/VMX network evidence (no vmrest)
# All commands emit one JSON envelope on stdout; logs go to stderr.
#   ./lab describe --json          command and error reference
set -euo pipefail
here=${BASH_SOURCE[0]%/*}
[[ "$here" != "${BASH_SOURCE[0]}" ]] || here=.
cmd="${1:-}"
[[ $# -gt 0 ]] && shift

# Only this process writes fd 3. Children inherit logs on stderr and record
# metadata in a private system-temp file; never exec away the EXIT trap.
exec 3>&1 1>&2
umask 077
LAB_RESULT_FILE=
LAB_DRY_RUN=0
if [[ "$cmd" == up || "$cmd" == down || "$cmd" == destroy ]]; then
  for arg in "$@"; do [[ "$arg" != --dry-run ]] || LAB_DRY_RUN=1; done
fi
export LAB_DRY_RUN
finish() {
  local rc=$?
  # Ignored dispositions also protect the writer subprocess from group signals.
  trap '' INT TERM
  trap - EXIT
  local envelope_rc=0
  python3 "$here/lib/envelope.py" finish "$LAB_RESULT_FILE" "$cmd" "$LAB_DRY_RUN" "$rc" >&3 3>&- || envelope_rc=$?
  rm -f -- "$LAB_RESULT_FILE" 3>&-
  exit "$envelope_rc"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
here=$(cd "$here" && pwd)
LAB_RESULT_FILE=$(mktemp 3>&-)
export LAB_RESULT_FILE
LAB_ENTRY_ONLY=1 source "$here/lib/config.sh" 3>&-

usage() { sed -n '2,14p' "${BASH_SOURCE[0]}" 3>&- | sed 's/^# \{0,1\}//' >&2 3>&-; lab_fail usage_error "Invalid command or arguments." "Run ./lab describe --json."; }

# Two lab commands on the same checkout (two terminals, an agent and a person)
# would race on the Terraform state, the base and the inventory.
# shellcheck source=lib/runner-functions.sh
source "$here/lib/runner-functions.sh"

case "$cmd" in
  describe)
    [[ "$#" == 1 && "$1" == --json ]] || usage
    lab_result "$(cat "$here/lib/describe.json" 3>&-)" ;;
  network)
    [[ $# -eq 0 ]] || usage
    bash "$here/lib/network.sh" 3>&- ;;
  setup)
    lock
    [[ $# -eq 0 || "$*" == --recreate ]] || usage
    missing=()
    for tool in terraform ansible-playbook qemu-img cloud-localds gpgv; do
      command -v "$tool" >/dev/null || missing+=("$tool")
    done
    [[ -f /usr/share/keyrings/ubuntu-cloudimage-keyring.gpg ]] || missing+=(ubuntu-cloudimage-keyring)
    if [[ ${#missing[@]} -gt 0 ]]; then
      echo "[INFO] Installing WSL tools (missing: ${missing[*]}); sudo asks for your WSL password"
      if [[ ! -t 0 || ! -t 2 ]] && ! sudo -n true 3>&-; then
        lab_fail needs_user "Installing WSL tools requires sudo authentication." "Run ./lab setup in your terminal."
      fi
      python3 "$here/lib/envelope.py" changed 3>&-
      sudo bash "$here/lib/wsl-tools.sh" 3>&-
    fi
    bash "$here/lib/base.sh" "$@" 3>&- ;;
  account)
    [[ $# -eq 0 || "$*" == --lock ]] || usage
    bash "$here/lib/account.sh" "$@" 3>&- ;;
  status)
    case "${1:-}" in
      --plan) lab_fail usage_error "status --plan was removed." "Use ./lab up --dry-run, ./lab down --all --dry-run, or ./lab destroy --dry-run." ;;
      --start-vmrest|'') ;;
      *) usage ;;
    esac
    [[ $# -le 1 ]] || usage
    rc=0
    bash "$here/lib/preflight.sh" "$@" 3>&- || rc=$?
    preflight_rc=$rc
    echo '== VMs'
    vm_rc=0
    bash "$here/lib/lifecycle.sh" status 3>&- || vm_rc=$?
    [[ "$rc" != 0 || "$vm_rc" == 0 ]] || rc=$vm_rc
    lab_result "{\"sections\":{\"preflight\":$preflight_rc,\"vms\":$vm_rc}}"
    exit "$rc" ;;
  up)        run_locked "$here/lib/lifecycle.sh" on "$@" ;;
  down)      run_locked "$here/lib/lifecycle.sh" off "$@" ;;
  destroy)   run_locked "$here/lib/lifecycle.sh" destroy "$@" ;;
  cleanup)   run_locked "$here/lib/lifecycle.sh" cleanup "$@" ;;
  configure)
    for arg in "$@"; do [[ "$arg" != --dry-run ]] || lab_fail usage_error "--dry-run is only supported by up, down and destroy."; done
    run_locked "$here/lib/configure.sh" "$@" ;;
  *) usage ;;
esac

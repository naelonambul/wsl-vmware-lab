#!/usr/bin/env bash
# The lab's single entry point (WSL). One lab command at a time per checkout.
#
#   ./lab setup [--recreate]       WSL tools, Ubuntu image, cloud-init seed, base VM (once)
#   ./lab status [--start-vmrest | --plan [on|off]]   checks; --plan: what up/down would change
#   ./lab up [--allow-destroy]     create new VMs from vms.tfvars and power all on
#   ./lab down                     power the existing VMs off
#   ./lab configure [PLAYBOOK] [ansible-playbook options]
#   ./lab destroy [-auto-approve]  delete every VM of this checkout
#   ./lab cleanup                  retry cleanup left by an interrupted delete
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
cmd="${1:-}"
[[ $# -gt 0 ]] && shift

usage() { sed -n '2,10p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }

# Two lab commands on the same checkout (two terminals, an agent and a person)
# would race on the Terraform state, the base and the inventory.
lock() {
  exec 9>"$here/.lab.lock"
  if ! flock -n 9; then
    echo "[ERROR] Another lab command is running in $here; wait for it to finish." >&2
    exit 1
  fi
}

case "$cmd" in
  setup)
    lock
    [[ $# -eq 0 || "$*" == --recreate ]] || usage
    missing=()
    for tool in terraform ansible-playbook qemu-img cloud-localds gpgv; do
      command -v "$tool" >/dev/null || missing+=("$tool")
    done
    [[ -f /usr/share/keyrings/ubuntu-cloudimage-keyring.gpg ]] || missing+=(ubuntu-cloudimage-keyring)
    if [[ ${#missing[@]} -gt 0 ]]; then
      echo "[INFO] Installing WSL tools (missing: ${missing[*]}); sudo asks for your WSL password"
      sudo bash "$here/lib/wsl-tools.sh"
    fi
    exec bash "$here/lib/base.sh" "$@" ;;
  status)
    case "${1:-}" in
      --plan) shift; exec bash "$here/lib/diagnose.sh" "$@" ;;   # read-only Terraform plan
      --start-vmrest|'') ;;
      *) usage ;;
    esac
    rc=0
    bash "$here/lib/preflight.sh" "$@" || rc=$?
    echo '== VMs'
    bash "$here/lib/lifecycle.sh" status || rc=$?
    exit "$rc" ;;
  up)        lock; exec bash "$here/lib/lifecycle.sh" on "$@" ;;
  down)      lock; exec bash "$here/lib/lifecycle.sh" off "$@" ;;
  destroy)   lock; exec bash "$here/lib/lifecycle.sh" destroy "$@" ;;
  cleanup)   lock; exec bash "$here/lib/lifecycle.sh" cleanup "$@" ;;
  configure) lock; exec bash "$here/lib/configure.sh" "$@" ;;
  *) usage ;;
esac
